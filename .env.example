# Azure service principal (optional — falls back to `az login` if unset)
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret

# GCP service account (optional — falls back to Application Default Credentials).
# Path to a service-account JSON key with BigQuery + Cloud Asset read access.
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

ANTHROPIC_API_KEY=your-api-key
FINOPS_AI_MODEL=claude-haiku-4-5-20251001
