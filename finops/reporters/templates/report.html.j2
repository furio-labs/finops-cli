<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>FinOps Report — {{ report.date_from }} to {{ report.date_to }}</title>
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: system-ui, sans-serif; background: #f0f2f5; color: #1a1a1a; }
  header { background: #1e3a5f; color: #fff; padding: 2rem; }
  header h1 { font-size: 1.6rem; margin-bottom: .25rem; }
  header p { opacity: .7; font-size: .9rem; }
  .metrics { display: flex; gap: 1.5rem; margin-top: 1.5rem; flex-wrap: wrap; }
  .metric { background: rgba(255,255,255,.12); border-radius: 8px; padding: 1rem 1.5rem; min-width: 140px; }
  .metric .value { font-size: 1.6rem; font-weight: 700; display: block; }
  .metric .label { font-size: .8rem; opacity: .75; }
  .severity-row { display: flex; gap: .75rem; margin-top: 1rem; flex-wrap: wrap; }
  .badge { padding: .25rem .75rem; border-radius: 999px; font-size: .78rem; font-weight: 600; white-space: nowrap; }
  .mp-badge { background: #f3e8ff; color: #6b21a8; padding: .1rem .4rem; border-radius: 4px; font-size: .7rem; font-weight: 700; margin-left: .3rem; vertical-align: middle; }
  .CRITICAL { background: #fee2e2; color: #991b1b; }
  .HIGH     { background: #fef3c7; color: #92400e; }
  .MEDIUM   { background: #e0f2fe; color: #075985; }
  .INFO     { background: #f0fdf4; color: #166534; }
  main { max-width: 100%; margin: 0; padding: 1rem 1.5rem; }
  section { background: #fff; border-radius: 10px; padding: 1.5rem; margin-bottom: 1.5rem; box-shadow: 0 1px 3px rgba(0,0,0,.08); }
  h2 { font-size: 1.1rem; margin-bottom: 1rem; color: #1e3a5f; border-bottom: 2px solid #e5e7eb; padding-bottom: .5rem; }
  h3 { font-size: .9rem; margin: 1.25rem 0 .5rem; color: #374151; font-weight: 600; }
  table { width: 100%; border-collapse: collapse; font-size: .82rem; }
  th { background: #f9fafb; text-align: left; padding: .5rem .75rem; font-weight: 600; border-bottom: 1px solid #e5e7eb; white-space: nowrap; cursor: pointer; user-select: none; }
  th:hover { background: #f1f5f9; }
  td { padding: .4rem .75rem; border-bottom: 1px solid #f3f4f6; vertical-align: middle; }
  tr:last-child td { border-bottom: none; }
  tr:hover td { background: #fafafa; }
  .rname { font-weight: 500; max-width: 220px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .rtype { font-size: .75rem; color: #6b7280; }
  .filter-bar { margin-bottom: 1rem; display: flex; gap: .5rem; flex-wrap: wrap; align-items: center; }
  .filter-bar input, .filter-bar select { padding: .4rem .75rem; border: 1px solid #d1d5db; border-radius: 6px; font-size: .85rem; }
  .filter-bar input { min-width: 240px; }
  .row-count { font-size: .78rem; color: #9ca3af; margin-left: .25rem; }
  .skipped { color: #d97706; font-style: italic; }
  .savings { color: #059669; font-weight: 600; }
  .cost-zero { color: #d1d5db; }
  .no-data { color: #9ca3af; font-size: .85rem; }
  .col-total { background: #f0fdf4 !important; }

  /* Monthly heat map */
  .monthly-wrap { overflow-x: auto; }
  .heat-1    { background: #fef9c3; }
  .heat-2    { background: #fde68a; }
  .heat-3    { background: #fcd34d; }
  .heat-4    { background: #f59e0b; color:#1a1a1a; }
  .heat-5    { background: #d97706; color:#fff; }
  .heat-6    { background: #b45309; color:#fff; }
  .heat-high { background: #991b1b; color:#fff; font-weight:700; }

  /* Leak cards */
  .leak-cards { display: flex; gap: 1rem; flex-wrap: wrap; margin-bottom: 1.5rem; }
  .leak-card {
    flex: 1; min-width: 150px; max-width: 220px;
    border: 2px solid #e5e7eb; border-radius: 8px; padding: 1rem;
    cursor: pointer; transition: box-shadow .15s, border-color .15s;
  }
  .leak-card:hover { box-shadow: 0 2px 8px rgba(0,0,0,.1); }
  .leak-card.active { border-color: #1e3a5f; }
  .leak-card.dimmed { opacity: .4; }
  .lc-count  { font-size: 2rem; font-weight: 700; color: #1e3a5f; line-height: 1; }
  .lc-label  { font-size: .85rem; font-weight: 600; margin: .35rem 0 .2rem; color: #374151; }
  .lc-savings { font-size: .82rem; }
  .lc-savings.green { color: #059669; font-weight: 600; }
  .lc-savings.grey  { color: #9ca3af; }

  /* Multi-select dropdown */
  .ms-wrap { position: relative; display: inline-block; }
  .ms-trigger {
    padding: .4rem .75rem; border: 1px solid #d1d5db; border-radius: 6px;
    cursor: pointer; font-size: .82rem; background: #fff; min-width: 220px;
    user-select: none; white-space: nowrap;
  }
  .ms-trigger:hover { border-color: #9ca3af; }
  .ms-drop {
    position: absolute; top: calc(100% + 4px); left: 0; z-index: 200;
    background: #fff; border: 1px solid #d1d5db; border-radius: 8px;
    box-shadow: 0 6px 16px rgba(0,0,0,.12); min-width: 240px;
    max-height: 260px; overflow-y: auto; display: none; padding: .4rem 0;
  }
  .ms-drop.open { display: block; }
  .ms-drop label {
    display: flex; align-items: center; gap: .5rem;
    padding: .28rem .85rem; cursor: pointer; font-size: .81rem;
  }
  .ms-drop label:hover { background: #f9fafb; }
  .ms-drop label.all-label { font-weight: 600; border-bottom: 1px solid #f3f4f6; padding-bottom: .45rem; margin-bottom: .2rem; }

  /* Summary row inside thead */
  .sum-row td, .sum-row th {
    background: #f0fdf4 !important; color: #059669; font-weight: 700;
    font-size: .8rem; border-bottom: 2px solid #bbf7d0; white-space: nowrap;
  }
  .sum-row td:first-child { color: #374151; font-weight: 600; }

  /* Selection summary card */
  .sel-card {
    display: inline-flex; align-items: stretch; gap: 0;
    background: #fff; border: 1px solid #e5e7eb; border-radius: 10px;
    box-shadow: 0 1px 4px rgba(0,0,0,.07); margin-bottom: .85rem; overflow: hidden;
  }
  .sel-card-stat {
    padding: .85rem 1.4rem; text-align: center; min-width: 110px;
  }
  .sel-card-stat + .sel-card-stat { border-left: 1px solid #f3f4f6; }
  .sel-card-val { display: block; font-size: 1.55rem; font-weight: 700; line-height: 1.1; color: #1e3a5f; }
  .sel-card-val.green { color: #059669; }
  .sel-card-lbl { display: block; font-size: .72rem; color: #9ca3af; margin-top: .2rem; text-transform: uppercase; letter-spacing: .04em; }
</style>
</head>
<body>

<header>
  <h1>FinOps Report</h1>
  <p>Período: {{ report.date_from }} — {{ report.date_to }} &nbsp;·&nbsp; Generado: {{ report.generated_at }} &nbsp;·&nbsp; Desarrollado por <a href="https://furiolabs.com" style="color:rgba(255,255,255,.8);text-decoration:none;" target="_blank">Furio Labs</a></p>
  <div class="metrics">
    <div class="metric">
      <span class="value">${{ "%.2f"|format(report.total_cost) }}</span>
      <span class="label">Gasto Total</span>
    </div>
    <div class="metric">
      <span class="value savings">~${{ "%.2f"|format(report.total_estimated_savings) }}</span>
      <span class="label">Ahorro Estimado/mes</span>
    </div>
    <div class="metric">
      <span class="value">{{ report.all_findings|length }}</span>
      <span class="label">Hallazgos</span>
    </div>
    <div class="metric">
      <span class="value">{{ report.subscriptions|length }}</span>
      <span class="label">Suscripciones</span>
    </div>
  </div>
  <div class="severity-row">
    {% for sev in ["CRITICAL","HIGH","MEDIUM","INFO"] %}
    {% set count = report.findings_by_severity().get(sev, [])|length %}
    <span class="badge {{ sev }}">{{ sev }}: {{ count }}</span>
    {% endfor %}
  </div>
</header>

<main>
{% for sub in report.subscriptions %}

{# ── Skipped subscription ──────────────────────────────────────────────── #}
{% if sub.skipped %}
<section>
  <h2>{{ sub.subscription_name }} ({{ sub.subscription_id }})</h2>
  <p class="skipped">&#x26A0; Omitida — {{ sub.skip_reason }}</p>
</section>

{% else %}
{% set evo   = evolution.get(sub.subscription_id, {"months":[], "resources":[], "max_cost":1}) %}
{% set cats  = leaks.get(sub.subscription_id, []) %}

{# ── Invoices ──────────────────────────────────────────────────────────── #}
{% if sub.invoices %}
<section>
  <h2>Facturas — {{ sub.subscription_name }}</h2>
  <table>
    <thead><tr><th>Período</th><th>Monto</th><th>Moneda</th><th>Estado</th><th>Vencimiento</th><th>PDF</th></tr></thead>
    <tbody>
    {% for inv in sub.invoices %}
    <tr>
      <td>{{ inv.billing_period }}</td>
      <td class="savings">${{ "%.2f"|format(inv.amount_due) }}</td>
      <td>{{ inv.currency }}</td>
      <td>{{ inv.status }}</td>
      <td>{{ inv.due_date or "—" }}</td>
      <td>{% if inv.pdf_url %}<a href="{{ inv.pdf_url }}" target="_blank">Descargar</a>{% else %}—{% endif %}</td>
    </tr>
    {% endfor %}
    </tbody>
  </table>
</section>
{% endif %}

{# ── Cost by resource group (with monthly evolution) ─────────────────────── #}
{% set rgd = rg_data.get(sub.subscription_id, {"months":[], "rgs":[], "monthly_totals":{}, "max_monthly":1}) %}
{% set rg_sid = sub.subscription_id %}
{% if rgd.rgs %}
<section>
  <h2>Costos por Resource Group — {{ sub.subscription_name }}</h2>

  {# Azure vs Marketplace split badges #}
  {% if evo.marketplace_total > 0 %}
  <div style="display:flex;gap:1rem;margin-bottom:1rem;flex-wrap:wrap;">
    <div style="background:#f0f9ff;border:1px solid #bae6fd;border-radius:8px;padding:.6rem 1.1rem;">
      <span style="font-size:.75rem;color:#0369a1;font-weight:600;">Azure Native</span>
      <span style="display:block;font-size:1.1rem;font-weight:700;color:#0c4a6e">${{ "%.2f"|format(evo.azure_total) }}</span>
    </div>
    <div style="background:#faf5ff;border:1px solid #d8b4fe;border-radius:8px;padding:.6rem 1.1rem;">
      <span style="font-size:.75rem;color:#6b21a8;font-weight:600;">Marketplace <span class="mp-badge">MP</span></span>
      <span style="display:block;font-size:1.1rem;font-weight:700;color:#581c87">${{ "%.2f"|format(evo.marketplace_total) }}</span>
    </div>
  </div>
  {% endif %}

  {# RG multi-select filter #}
  <div class="filter-bar">
    <div class="ms-wrap">
      <div class="ms-trigger" id="rg-trig-{{ rg_sid }}" onclick="msToggle('rg-drop-{{ rg_sid }}')">Todos los Resource Groups ▾</div>
      <div class="ms-drop" id="rg-drop-{{ rg_sid }}">
        <label class="all-label"><input type="checkbox" value="__all__" checked onchange="msAllRg('{{ rg_sid }}')"> Todos</label>
        {% for rg in rgd.rgs %}
        <label><input type="checkbox" value="{{ rg.name }}" checked onchange="msChgRg('{{ rg_sid }}')"> {{ rg.name }}</label>
        {% endfor %}
      </div>
    </div>
    <span class="row-count" id="rg-rc-{{ rg_sid }}">{{ rgd.rgs|length }} resource groups</span>
  </div>

  <div class="sel-card">
    <div class="sel-card-stat">
      <span class="sel-card-val" id="rg-card-n-{{ rg_sid }}">{{ rgd.rgs|length }}</span>
      <span class="sel-card-lbl">Resource Groups</span>
    </div>
    <div class="sel-card-stat">
      <span class="sel-card-val green" id="rg-card-t-{{ rg_sid }}">${{ "%.2f"|format(rgd.rgs | map(attribute='total') | sum) }}</span>
      <span class="sel-card-lbl">Gasto Total</span>
    </div>
  </div>

  <div class="monthly-wrap">
  <table id="rg-tbl-{{ rg_sid }}">
    <thead>
    <tr>
      <th onclick="sortTbl('rg-tbl-{{ rg_sid }}',0)">Resource Group ↕</th>
      <th onclick="sortTbl('rg-tbl-{{ rg_sid }}',1)">Recursos</th>
      {% for m in rgd.months %}<th onclick="sortTbl('rg-tbl-{{ rg_sid }}',{{ loop.index + 1 }})">{{ m }}</th>{% endfor %}
      <th class="col-total" onclick="sortTbl('rg-tbl-{{ rg_sid }}',{{ rgd.months|length + 2 }})">Total ↕</th>
    </tr>
    <tr class="sum-row">
      <td id="rg-sum-n-{{ rg_sid }}">{{ rgd.rgs|length }} seleccionados</td>
      <td></td>
      {% for m in rgd.months %}
      <td id="rg-sum-m-{{ rg_sid }}-{{ m|replace('-','') }}">${{ "%.2f"|format(rgd.monthly_totals.get(m, 0)) }}</td>
      {% endfor %}
      <td id="rg-sum-t-{{ rg_sid }}">${{ "%.2f"|format(rgd.rgs | map(attribute='total') | sum) }}</td>
    </tr>
    </thead>
    <tbody>
    {% for rg in rgd.rgs %}
    <tr data-rg="{{ rg.name }}">
      <td class="rname">{{ rg.name }}</td>
      <td style="color:#6b7280;font-size:.8rem;">{{ rg.count }}</td>
      {% for m in rgd.months %}
      {% set mv = rg.monthly.get(m, 0) %}
      <td class="{{ heat_class(mv, rgd.max_monthly) }}" data-v="{{ mv }}" data-month="{{ m }}">
        {% if mv > 0 %}${{ "%.2f"|format(mv) }}{% else %}<span class="cost-zero">—</span>{% endif %}
      </td>
      {% endfor %}
      <td class="col-total savings" data-v="{{ rg.total }}" data-col="total">${{ "%.2f"|format(rg.total) }}</td>
    </tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
</section>
{% endif %}

{# ── Marketplace detail ────────────────────────────────────────────────── #}
{% set mp = marketplace.get(sub.subscription_id) %}
{% if mp %}
{% set mp_sid = sub.subscription_id ~ "-mp" %}
<section style="border-left:4px solid #a855f7;">
  <h2>Costos Marketplace — {{ sub.subscription_name }}</h2>

  {# Summary bar #}
  <div style="display:flex;gap:1.5rem;align-items:center;margin-bottom:1.25rem;flex-wrap:wrap;">
    <div>
      <span style="font-size:1.8rem;font-weight:700;color:#581c87">${{ "%.2f"|format(mp.total) }}</span>
      <span style="font-size:.82rem;color:#6b21a8;margin-left:.5rem;">total Marketplace</span>
    </div>
    <div style="font-size:.85rem;color:#6b7280;">
      {{ "%.1f"|format(mp.pct_of_sub) }}% del gasto total de la suscripción
    </div>
    <div style="margin-left:auto;">
      <input type="text" id="mp-q-{{ mp_sid }}"
             placeholder="Filtrar…"
             oninput="mpFilter('{{ mp_sid }}')"
             style="padding:.35rem .75rem;border:1px solid #d1d5db;border-radius:6px;font-size:.82rem;">
    </div>
  </div>

  <div style="overflow-x:auto;">
  <table id="mp-tbl-{{ mp_sid }}">
    <thead><tr>
      <th onclick="sortTbl('mp-tbl-{{ mp_sid }}',0)">Servicio ↕</th>
      <th>Tipo</th>
      <th>Resource Group</th>
      <th>Resource ID</th>
      {% for m in mp.months %}<th onclick="sortTbl('mp-tbl-{{ mp_sid }}',{{ loop.index + 3 }})">{{ m }}</th>{% endfor %}
      <th onclick="sortTbl('mp-tbl-{{ mp_sid }}',{{ mp.months|length + 4 }})" style="background:#faf5ff;">Total ↕</th>
      <th style="background:#faf5ff;">% Suscripción</th>
    </tr></thead>
    <tbody>
    {% for item in mp.entries %}
    <tr data-mp-s="{{ item.name|lower }} {{ item.service_name|lower }} {{ item.resource_group|lower }}">
      <td style="font-weight:600;min-width:160px;">
        {{ item.name }}
        <span class="mp-badge">MP</span>
      </td>
      <td class="rtype">{{ item.resource_type.split("/")[-1] }}</td>
      <td class="rtype">{{ item.resource_group or "—" }}</td>
      <td class="rtype" style="max-width:220px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="{{ item.resource_id }}">
        {{ item.resource_id.split("/")[-1] }}
      </td>
      {% for m in mp.months %}
      {% set mv = item.monthly.get(m, 0) %}
      <td data-v="{{ mv }}" style="{% if mv > 0 %}color:#581c87;font-weight:600{% else %}color:#d1d5db{% endif %}">
        {% if mv > 0 %}${{ "%.2f"|format(mv) }}{% else %}—{% endif %}
      </td>
      {% endfor %}
      <td data-v="{{ item.total }}" style="background:#faf5ff;font-weight:700;color:#581c87">
        ${{ "%.2f"|format(item.total) }}
      </td>
      <td style="background:#faf5ff;color:#6b7280;font-size:.8rem;">
        {{ "%.1f"|format(item.pct_of_sub) }}%
      </td>
    </tr>
    {% endfor %}
    {# Totals row #}
    <tr style="border-top:2px solid #e5e7eb;font-weight:700;background:#faf5ff;">
      <td colspan="4" style="color:#581c87;">Total Marketplace</td>
      {% for m in mp.months %}
      {% set mv = mp.monthly_totals.get(m, 0) %}
      <td style="color:#581c87;">${{ "%.2f"|format(mv) }}</td>
      {% endfor %}
      <td style="color:#581c87;">${{ "%.2f"|format(mp.total) }}</td>
      <td style="color:#6b7280;">{{ "%.1f"|format(mp.pct_of_sub) }}%</td>
    </tr>
    </tbody>
  </table>
  </div>
</section>
{% endif %}

{# ── Monthly evolution ─────────────────────────────────────────────────── #}
{% if evo.resources %}
{% set sid = sub.subscription_id %}
{# Unique RGs for the evolution multi-select #}
{% set evo_rgs = evo.resources | map(attribute="resource_group") | unique | sort | list %}
<section>
  <h2>Evolución Mensual por Recurso — {{ sub.subscription_name }}</h2>
  <div class="filter-bar">
    <input type="text" id="evo-q-{{ sid }}"
           placeholder="Filtrar por nombre o tipo…"
           oninput="evoFilter('{{ sid }}')">
    <div class="ms-wrap">
      <div class="ms-trigger" id="evo-trig-{{ sid }}" onclick="msToggle('evo-drop-{{ sid }}')">Todos los Resource Groups ▾</div>
      <div class="ms-drop" id="evo-drop-{{ sid }}">
        <label class="all-label"><input type="checkbox" value="__all__" checked onchange="msAllEvo('{{ sid }}')"> Todos</label>
        {% for rg in evo_rgs %}
        <label><input type="checkbox" value="{{ rg }}" checked onchange="msChgEvo('{{ sid }}')"> {{ rg }}</label>
        {% endfor %}
      </div>
    </div>
    <span class="row-count" id="evo-n-{{ sid }}">{{ evo.resources|length }} recursos</span>
  </div>

  <div class="sel-card">
    <div class="sel-card-stat">
      <span class="sel-card-val" id="evo-card-n-{{ sid }}">{{ evo.resources|length }}</span>
      <span class="sel-card-lbl">Recursos</span>
    </div>
    <div class="sel-card-stat">
      <span class="sel-card-val green" id="evo-card-t-{{ sid }}">${{ "%.2f"|format(evo.resources | map(attribute='total') | sum) }}</span>
      <span class="sel-card-lbl">Gasto Total</span>
    </div>
  </div>

  {# Pre-compute evo monthly totals in Jinja for initial render #}
  {% set evo_mt = namespace(data={}) %}
  {% for r in evo.resources %}
    {% for m, v in r.monthly.items() %}
      {% set evo_mt.data = evo_mt.data.update({m: evo_mt.data.get(m,0)+v}) or evo_mt.data %}
    {% endfor %}
  {% endfor %}

  <div class="monthly-wrap">
  <table id="evo-{{ sid }}">
    <thead>
    <tr>
      <th onclick="sortTbl('evo-{{ sid }}',0)">Recurso ↕</th>
      <th onclick="sortTbl('evo-{{ sid }}',1)">Tipo</th>
      <th onclick="sortTbl('evo-{{ sid }}',2)">Resource Group</th>
      {% for m in evo.months %}<th onclick="sortTbl('evo-{{ sid }}',{{ loop.index + 2 }})">{{ m }}</th>{% endfor %}
      <th class="col-total" onclick="sortTbl('evo-{{ sid }}',{{ evo.months|length + 3 }})">Total ↕</th>
    </tr>
    <tr class="sum-row">
      <td id="evo-sum-n-{{ sid }}">{{ evo.resources|length }} seleccionados</td>
      <td></td>
      <td></td>
      {% for m in evo.months %}
      <td id="evo-sum-m-{{ sid }}-{{ m|replace('-','') }}">${{ "%.2f"|format(evo_mt.data.get(m,0)) }}</td>
      {% endfor %}
      <td id="evo-sum-t-{{ sid }}">${{ "%.2f"|format(evo.resources | map(attribute='total') | sum) }}</td>
    </tr>
    </thead>
    <tbody>
    {% for r in evo.resources %}
    <tr data-s="{{ r.name|lower }} {{ r.type_short|lower }}" data-rg="{{ r.resource_group }}">
      <td class="rname" title="{{ r.resource_id }}">{{ r.name }}</td>
      <td class="rtype">{{ r.type_short }}</td>
      <td class="rtype">{{ r.resource_group }}</td>
      {% for m in evo.months %}
      {% set mv = r.monthly.get(m, 0) %}
      <td class="{{ heat_class(mv, evo.max_cost) }}" data-v="{{ mv }}" data-month="{{ m }}">
        {% if mv > 0 %}${{ "%.2f"|format(mv) }}{% else %}<span class="cost-zero">—</span>{% endif %}
      </td>
      {% endfor %}
      <td class="col-total savings" data-v="{{ r.total }}" data-col="total">${{ "%.2f"|format(r.total) }}</td>
    </tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
</section>
{% endif %}

{# ── Potential leaks & savings ─────────────────────────────────────────── #}
{% if sub.findings %}
{% set sid = sub.subscription_id %}
<section>
  <h2>Fugas de Costos y Ahorros Potenciales — {{ sub.subscription_name }}</h2>

  {# Category cards #}
  <div class="leak-cards" id="cards-{{ sid }}">
    {% for cat in cats %}
    <div class="leak-card active"
         id="card-{{ sid }}-{{ cat.category }}"
         onclick="leakCard('{{ sid }}','{{ cat.category }}')">
      <div class="lc-count">{{ cat.findings|length }}</div>
      <div class="lc-label">{{ cat.category }}</div>
      <div class="lc-savings {% if cat.total_savings > 0 %}green{% else %}grey{% endif %}">
        {% if cat.total_savings > 0 %}
          ~${{ "%.2f"|format(cat.total_savings) }}/mes
        {% else %}
          Gobernanza
        {% endif %}
      </div>
    </div>
    {% endfor %}
  </div>

  {# Filter bar #}
  <div class="filter-bar">
    <input type="text" id="lk-q-{{ sid }}"
           placeholder="Filtrar por recurso o recomendación…"
           oninput="leakFilter('{{ sid }}')">
    <select id="lk-sev-{{ sid }}" onchange="leakFilter('{{ sid }}')">
      <option value="">Todas las severidades</option>
      <option>CRITICAL</option><option>HIGH</option><option>MEDIUM</option><option>INFO</option>
    </select>
    <span class="row-count" id="lk-n-{{ sid }}">{{ sub.findings|length }} hallazgos</span>
  </div>

  <table id="lk-{{ sid }}">
    <thead><tr>
      <th>Severidad</th><th>Categoría</th><th>Recurso</th>
      <th>Tipo</th><th>Resource Group</th>
      <th>Ahorro Est./mes</th><th>Recomendación</th>
    </tr></thead>
    <tbody>
    {% for f in sub.findings | sort(attribute="severity", reverse=True) %}
    <tr data-cat="{{ f.category }}" data-sev="{{ f.severity }}">
      <td><span class="badge {{ f.severity }}">{{ f.severity }}</span></td>
      <td>{{ f.category }}</td>
      <td class="rname" title="{{ f.resource_id }}">{{ f.resource_id.split("/")[-1] }}</td>
      <td class="rtype">{{ f.resource_type.split("/")[-1] }}</td>
      <td class="rtype">{{ f.resource_group }}</td>
      <td>{% if f.estimated_monthly_savings_usd > 0 %}<span class="savings">~${{ "%.2f"|format(f.estimated_monthly_savings_usd) }}</span>{% else %}—{% endif %}</td>
      <td>{{ f.recommendation }}</td>
    </tr>
    {% endfor %}
    </tbody>
  </table>
</section>
{% endif %}

{# ── Per-resource detail ───────────────────────────────────────────────── #}
<section>
  <h2>Detalle por Recurso — {{ sub.subscription_name }}</h2>
  {% set cost_idx = namespace(data={}) %}
  {% for c in sub.costs %}{% set _ = cost_idx.data.update({c.resource_id: c.total_cost}) %}{% endfor %}
  {% set find_idx = namespace(data={}) %}
  {% for f in sub.findings %}
    {% if f.resource_id not in find_idx.data %}{% set _ = find_idx.data.update({f.resource_id: []}) %}{% endif %}
    {% set _ = find_idx.data[f.resource_id].append(f) %}
  {% endfor %}

  {% for rg in sub.resources | map(attribute="resource_group") | unique | sort %}
  {% set rg_res = sub.resources | selectattr("resource_group","equalto",rg) | list %}
  {% set rg_total = namespace(v=0) %}
  {% for r in rg_res %}{% set rg_total.v = rg_total.v + cost_idx.data.get(r.id, 0) %}{% endfor %}
  <h3>{{ rg }} &nbsp;<span style="color:#059669;font-weight:400">${{ "%.2f"|format(rg_total.v) }}</span></h3>
  <table>
    <thead><tr><th>Nombre</th><th>Tipo</th><th>SKU</th><th>Costo Total</th><th>Hallazgos</th></tr></thead>
    <tbody>
    {% for r in rg_res | sort(attribute="name") %}
    {% set rc = cost_idx.data.get(r.id, 0) %}
    <tr>
      <td class="rname" title="{{ r.id }}">{{ r.name }}</td>
      <td class="rtype">{{ r.type.split("/")[-1] }}</td>
      <td class="rtype">{{ r.sku_name or "—" }}</td>
      <td>{% if rc > 0 %}<span class="savings">${{ "%.2f"|format(rc) }}</span>{% else %}<span class="cost-zero">—</span>{% endif %}</td>
      <td>
        {% for f in find_idx.data.get(r.id, []) %}
        <span class="badge {{ f.severity }}" title="{{ f.recommendation }}">{{ f.category }}</span>
        {% else %}—
        {% endfor %}
      </td>
    </tr>
    {% endfor %}
    </tbody>
  </table>
  {% endfor %}
</section>

{% endif %}
{% endfor %}
</main>

<script>
// ── Multi-select helpers ───────────────────────────────────────────────────
function msToggle(dropId) {
  const d = document.getElementById(dropId);
  document.querySelectorAll('.ms-drop.open').forEach(x => { if (x.id !== dropId) x.classList.remove('open'); });
  d.classList.toggle('open');
}
document.addEventListener('click', e => {
  if (!e.target.closest('.ms-wrap')) document.querySelectorAll('.ms-drop.open').forEach(d => d.classList.remove('open'));
});

function _msSelected(dropId) {
  return new Set(Array.from(document.querySelectorAll('#' + dropId + ' input:not([value="__all__"])')).filter(b => b.checked).map(b => b.value));
}
function _msSyncAll(dropId, trigId) {
  const boxes = document.querySelectorAll('#' + dropId + ' input:not([value="__all__"])');
  const checked = Array.from(boxes).filter(b => b.checked);
  const allBox = document.querySelector('#' + dropId + ' input[value="__all__"]');
  allBox.checked = checked.length === boxes.length;
  allBox.indeterminate = checked.length > 0 && checked.length < boxes.length;
  const trig = document.getElementById(trigId);
  if (trig) trig.textContent = checked.length === boxes.length ? 'Todos los Resource Groups ▾'
    : checked.length === 0 ? 'Sin selección ▾'
    : checked.length + ' seleccionados ▾';
}
function msAllRg(sid) {
  const allBox = document.querySelector('#rg-drop-' + sid + ' input[value="__all__"]');
  document.querySelectorAll('#rg-drop-' + sid + ' input:not([value="__all__"])').forEach(b => b.checked = allBox.checked);
  _msSyncAll('rg-drop-' + sid, 'rg-trig-' + sid);
  rgFilter(sid);
}
function msChgRg(sid) { _msSyncAll('rg-drop-' + sid, 'rg-trig-' + sid); rgFilter(sid); }
function msAllEvo(sid) {
  const allBox = document.querySelector('#evo-drop-' + sid + ' input[value="__all__"]');
  document.querySelectorAll('#evo-drop-' + sid + ' input:not([value="__all__"])').forEach(b => b.checked = allBox.checked);
  _msSyncAll('evo-drop-' + sid, 'evo-trig-' + sid);
  evoFilter(sid);
}
function msChgEvo(sid) { _msSyncAll('evo-drop-' + sid, 'evo-trig-' + sid); evoFilter(sid); }

// ── Summary recompute ─────────────────────────────────────────────────────
function _recomputeSum(tableId, sumNId, sumMonthPrefix, sumTId, cardNId, cardTId) {
  const rows = Array.from(document.querySelectorAll('#' + tableId + ' tbody tr[data-rg]')).filter(r => r.style.display !== 'none');
  const count = rows.length;

  // Update thead sum row
  const n = document.getElementById(sumNId);
  if (n) n.textContent = count + ' seleccionados';

  // Sum by month (cells with data-month attr)
  const monthSums = {};
  let total = 0;
  rows.forEach(r => {
    r.querySelectorAll('td[data-month]').forEach(td => {
      const m = td.dataset.month.replace('-', '');
      monthSums[m] = (monthSums[m] || 0) + (parseFloat(td.dataset.v) || 0);
    });
    const tc = r.querySelector('td[data-col="total"]');
    if (tc) total += parseFloat(tc.dataset.v) || 0;
  });

  Object.entries(monthSums).forEach(([m, v]) => {
    const el = document.getElementById(sumMonthPrefix + m);
    if (el) el.textContent = '$' + v.toFixed(2);
  });
  const t = document.getElementById(sumTId);
  if (t) t.textContent = '$' + total.toFixed(2);

  // Update selection card
  const cn = document.getElementById(cardNId);
  if (cn) cn.textContent = count;
  const ct = document.getElementById(cardTId);
  if (ct) ct.textContent = '$' + total.toFixed(2);
}

// ── RG table filter ────────────────────────────────────────────────────────
function rgFilter(sid) {
  const selected = _msSelected('rg-drop-' + sid);
  const rows = document.querySelectorAll('#rg-tbl-' + sid + ' tbody tr[data-rg]');
  let n = 0;
  rows.forEach(r => {
    const show = selected.size === 0 || selected.has(r.dataset.rg);
    r.style.display = show ? '' : 'none';
    if (show) n++;
  });
  const rc = document.getElementById('rg-rc-' + sid);
  if (rc) rc.textContent = n + ' resource groups';
  _recomputeSum('rg-tbl-' + sid, 'rg-sum-n-' + sid, 'rg-sum-m-' + sid + '-', 'rg-sum-t-' + sid, 'rg-card-n-' + sid, 'rg-card-t-' + sid);
}

// ── Evolution table filter ─────────────────────────────────────────────────
function evoFilter(sid) {
  const q = (document.getElementById('evo-q-' + sid)?.value || '').toLowerCase();
  const selectedRg = _msSelected('evo-drop-' + sid);
  const rows = document.querySelectorAll('#evo-' + sid + ' tbody tr[data-rg]');
  let n = 0;
  rows.forEach(r => {
    const matchQ  = !q || r.dataset.s.includes(q);
    const matchRg = selectedRg.size === 0 || selectedRg.has(r.dataset.rg);
    const show = matchQ && matchRg;
    r.style.display = show ? '' : 'none';
    if (show) n++;
  });
  const el = document.getElementById('evo-n-' + sid);
  if (el) el.textContent = n + ' recursos';
  _recomputeSum('evo-' + sid, 'evo-sum-n-' + sid, 'evo-sum-m-' + sid + '-', 'evo-sum-t-' + sid, 'evo-card-n-' + sid, 'evo-card-t-' + sid);
}

// ── Marketplace filter ─────────────────────────────────────────────────────
function mpFilter(mpSid) {
  const q = document.getElementById('mp-q-' + mpSid).value.toLowerCase();
  document.querySelectorAll('#mp-tbl-' + mpSid + ' tbody tr[data-mp-s]').forEach(r => {
    r.style.display = !q || r.dataset.mpS.includes(q) ? '' : 'none';
  });
}

// ── Leak category cards ────────────────────────────────────────────────────
const _activeCat = {};
function leakCard(sid, cat) {
  _activeCat[sid] = _activeCat[sid] === cat ? '' : cat;
  document.querySelectorAll('[id^="card-' + sid + '-"]').forEach(c => {
    const mine = c.id === 'card-' + sid + '-' + _activeCat[sid];
    c.classList.toggle('active',  !_activeCat[sid] || mine);
    c.classList.toggle('dimmed', !!_activeCat[sid] && !mine);
  });
  leakFilter(sid);
}
function leakFilter(sid) {
  const cat  = _activeCat[sid] || '';
  const q    = document.getElementById('lk-q-'  + sid).value.toLowerCase();
  const sev  = document.getElementById('lk-sev-'+ sid).value;
  const rows = document.querySelectorAll('#lk-' + sid + ' tbody tr');
  let n = 0;
  rows.forEach(r => {
    const ok = (!cat || r.dataset.cat === cat)
            && (!sev  || r.dataset.sev === sev)
            && (!q    || r.textContent.toLowerCase().includes(q));
    r.style.display = ok ? '' : 'none';
    if (ok) n++;
  });
  const el = document.getElementById('lk-n-' + sid);
  if (el) el.textContent = n + ' hallazgos';
}

// ── Column sort ────────────────────────────────────────────────────────────
function sortTbl(id, col) {
  const tbl = document.getElementById(id);
  if (!tbl) return;
  const tbody = tbl.tBodies[0];
  const th = tbl.tHead.rows[0].cells[col];
  const asc = th.dataset.dir !== 'asc';
  th.dataset.dir = asc ? 'asc' : 'desc';
  Array.from(tbody.rows)
    .filter(r => r.dataset.rg !== undefined || r.dataset.s !== undefined)
    .sort((a, b) => {
      const av = a.cells[col]?.dataset.v ?? a.cells[col]?.textContent.trim() ?? '';
      const bv = b.cells[col]?.dataset.v ?? b.cells[col]?.textContent.trim() ?? '';
      const an = parseFloat(av), bn = parseFloat(bv);
      return (!isNaN(an) && !isNaN(bn))
        ? (asc ? an - bn : bn - an)
        : (asc ? av.localeCompare(bv) : bv.localeCompare(av));
    })
    .forEach(r => tbody.appendChild(r));
}
</script>
</body>
</html>
